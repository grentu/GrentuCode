{
  "name": "grentucode-desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "GrentuCode desktop shell — Electron + Vite + React over the v4 orchestrator core.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron": "npm run build && npm run electron:build && electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^32.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
